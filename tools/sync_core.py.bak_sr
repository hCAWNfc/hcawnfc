#!/usr/bin/env python3
"""Fills the package from the working folder (sft/fc). Run it before every build.

  python tools/sync_core.py --src from_fc --eval fc_mobile_eval.jsonl --int8 model5_int8.bin --int4 model5_C_pack.bin --no-bundle

What it does:
  * copies fc_*.py and hcawn_cpp.py into src/hcawn_fc/_core/ and rewrites their imports to relative ones
  * copies hcawn.cpp into csrc/ (private, not committed to git)
  * writes src/hcawn_fc/data/tools.json (the 7 tools + the context format) from your fc_mobile_eval.jsonl,
    exactly as the model saw them in training
  * with --int8 / --int4 the weights are hashed; they are copied into the package only without --no-bundle.
    With --no-bundle only data/weights.json (SHA-256 sums) is written, for `hcawn-fc download`.
"""
import argparse, hashlib, json, os, re, shutil, sys

CORE = ["fc_common", "fc_conf", "fc_dates", "fc_fix", "fc_triggers", "fc_constrained", "fc_augment", "hcawn_cpp"]
IMPORT_RE = re.compile(r"^(\s*)from (" + "|".join(CORE) + r") import ", re.M)
HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)


def find(src, name):
    for d in (src, os.path.dirname(src)):
        p = os.path.join(d, name)
        if os.path.isfile(p):
            return p
    sys.exit(f"missing {name} (looked in {src} and the folder above it)")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--src", required=True, help="folder with fc_*.py (sft/fc)")
    ap.add_argument("--eval", required=True, help="fc_mobile_eval.jsonl (the tool definitions are taken from it)")
    ap.add_argument("--int8"); ap.add_argument("--int4")
    ap.add_argument("--no-bundle", action="store_true", help="do NOT put the weights into the package; only write their SHA-256 sums (data/weights.json) for hcawn-fc download")
    ap.add_argument("--repo", default="datatab/hcawn-fc7", help="Hugging Face repo that hosts the weights")
    a = ap.parse_args()
    src = os.path.abspath(os.path.expanduser(a.src))
    core = os.path.join(ROOT, "src", "hcawn_fc", "_core"); os.makedirs(core, exist_ok=True)
    open(os.path.join(core, "__init__.py"), "w").write('"""Core: rules, grammar and the wrapper around the C++ engine. Generated by tools/sync_core.py, do not edit by hand."""\n')
    for m in CORE:
        text = open(find(src, m + ".py"), encoding="utf-8").read()
        text, n = IMPORT_RE.subn(lambda mo: f"{mo.group(1)}from .{mo.group(2)} import ", text)
        open(os.path.join(core, m + ".py"), "w", encoding="utf-8").write(text)
        print(f"  {m}.py ({n} imports rewritten)")
    os.makedirs(os.path.join(ROOT, "csrc"), exist_ok=True)
    shutil.copy(find(src, "hcawn.cpp"), os.path.join(ROOT, "csrc", "hcawn.cpp"))
    print("  hcawn.cpp")

    ev = find(src, a.eval) if not os.path.isfile(a.eval) else a.eval
    rows = [json.loads(l) for l in open(ev, encoding="utf-8") if l.strip()]
    best = max(rows, key=lambda r: len(r["tools"]))
    ctx = next((r.get("context", "") for r in rows if re.search(r"\d{4}-\d{2}-\d{2}", r.get("context", ""))), best.get("context", ""))
    data = os.path.join(ROOT, "src", "hcawn_fc", "data"); os.makedirs(data, exist_ok=True)
    blob = {"source": os.path.basename(ev), "tools": best["tools"], "context": ctx}
    json.dump(blob, open(os.path.join(data, "tools.json"), "w", encoding="utf-8"), ensure_ascii=False, indent=1)
    print(f"  tools.json: {len(best['tools'])} tools ({', '.join(t['name'] for t in best['tools'])})")
    files = {}
    for tag, p in (("int8", a.int8), ("int4", a.int4)):
        dst = os.path.join(data, tag + ".bin")
        if p:
            srcp = find(src, p) if not os.path.isfile(p) else p
            raw = open(srcp, "rb").read()
            files[tag] = {"file": f"{tag}.bin", "sha256": hashlib.sha256(raw).hexdigest(), "size": len(raw)}
            if a.no_bundle:
                if os.path.isfile(dst): os.remove(dst)
                print(f"  {tag}.bin ({len(raw) / 1e6:.1f} MB, sha256 {files[tag]['sha256'][:12]}) not bundled, checksum only")
            else:
                shutil.copy(srcp, dst)
                print(f"  {tag}.bin ({len(raw) / 1e6:.1f} MB, sha256 {files[tag]['sha256'][:12]})")
        elif os.path.isfile(dst):
            os.remove(dst); print(f"  {tag}.bin removed (not requested)")
    wm = os.path.join(data, "weights.json")
    if files:
        json.dump({"repo": a.repo, "files": files}, open(wm, "w"), indent=1)
        print(f"  weights.json: {a.repo}, {', '.join(files)}")
    elif os.path.isfile(wm):
        os.remove(wm)
    print("done. Next: bash tools/build_release.sh  (or: python -m build)")


if __name__ == "__main__":
    main()
